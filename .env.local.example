# Present-Agent2 environment configuration (example)

# Core APIs (at least one of OpenAI or Anthropic is required)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Neo4j Database (Aura or local)
NEO4J_URL=neo4j+s://<your-instance>.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# Server configuration
BACKEND_PORT=3000
# URL used in magic-link emails and redirects
FRONTEND_URL=http://localhost:3001

# Optional email settings (for magic links). Leave unset to log preview URLs instead of sending.
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USER=
# EMAIL_PASS=
# EMAIL_FROM=

# Redis cache (optional)
# REDIS_URL=redis://default:password@host:port
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=
CACHE_ENABLED=true
CACHE_STATS_INTERVAL=600

# Logging
LOG_LEVEL=info

# Notes
# - COHERE_API_KEY, VECTOR_DB_URL, MODEL_NAME are not used by the current codebase.
# - Some scripts historically used NEO4J_USER; the code now accepts both NEO4J_USERNAME and NEO4J_USER.
# - Do NOT commit real secrets. Copy this file to `.env.local` and fill values locally.

