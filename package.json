{
  "name": "present-agent2",
  "version": "0.1.0",
  "description": "AI-powered gift recommendation engine using Neo4j + vector embeddings",
  "type": "module",
  "scripts": {
    "setup:schema": "tsx scripts/setup-schema.ts",
    "ingest": "tsx scripts/ingest-data.ts",
    "ingest:sample": "tsx scripts/ingest-sample.ts",
    "search": "tsx scripts/cli.ts search",
    "benchmark": "tsx scripts/cli.ts benchmark",
    "server": "tsx src/server.ts",
    "server:dev": "tsx --watch src/server.ts",
    "frontend": "cd frontend && npm run dev",
    "dev": "concurrently \"npm run server:dev\" \"npm run frontend\"",
    "test": "vitest",
    "test:personas": "tsx scripts/test-personas.ts",
    "test:personas:list": "tsx scripts/test-personas.ts list",
    "test:personas:quick": "tsx scripts/test-personas.ts quick",
    "test:personas:batch": "tsx scripts/test-personas.ts batch",
    "test:cache": "tsx scripts/test-cache.ts",
    "test:real-users": "tsx scripts/test-real-user-scenarios.ts",
    "test:real-users:easy": "tsx scripts/test-real-user-scenarios.ts easy",
    "test:real-users:medium": "tsx scripts/test-real-user-scenarios.ts medium",
    "test:real-users:hard": "tsx scripts/test-real-user-scenarios.ts hard",
    "test:real-users:expert": "tsx scripts/test-real-user-scenarios.ts expert",
    "chat": "tsx scripts/chat.ts",
    "attributes:populate": "tsx scripts/populate-gift-attributes.ts --live",
    "attributes:test": "tsx scripts/populate-gift-attributes.ts --limit 100",
    "attributes:test-llm": "tsx scripts/test-llm-attributes.ts",
    "attributes:test-llm:20": "tsx scripts/test-llm-attributes.ts 20",
    "attributes:populate:llm": "tsx scripts/populate-gift-attributes.ts --live --use-llm",
    "attributes:populate:llm-test": "tsx scripts/populate-gift-attributes.ts --limit 100 --use-llm",
    "attributes:populate:llm-resume": "tsx scripts/populate-gift-attributes.ts --live --use-llm --resume",
    "attributes:populate:missing": "tsx scripts/populate-missing-attributes.ts",
    "attributes:status": "tsx scripts/check-attribute-status.ts"
  },
  "keywords": [
    "recommendation-engine",
    "neo4j",
    "vector-embeddings",
    "gift-recommendations"
  ],
  "dependencies": {
    "@anthropic-ai/sdk": "^0.10.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/nodemailer": "^7.0.3",
    "@types/stream-json": "^1.7.8",
    "axios": "^1.13.1",
    "body-parser": "^2.2.0",
    "boxen": "^7.1.1",
    "chalk": "^5.3.0",
    "commander": "^11.1.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^5.1.0",
    "inquirer": "^9.2.12",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.2",
    "neo4j-driver": "^5.15.0",
    "nodemailer": "^7.0.10",
    "openai": "^4.20.0",
    "ora": "^8.0.1",
    "stream-json": "^1.9.1",
    "winston": "^3.11.0",
    "wrap-ansi": "^9.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "concurrently": "^9.2.1",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  }
}
